# cth-terminus-2-stream 1.0.0: 262144 window / 65536 headroom, no max_turns, local token estimate.
# Recorded sandbox size 4 cpu / 8Gi / 50Gi; agent deadline 14400 s (TB2.1) or 18000 s (TerminalHorizon).
# Plain KEY=VALUE: usable with `set -a; . file; set +a` and with `docker run --env-file`.
# TERMINUS_TOKEN_COUNT_MODE=estimate is NOT in the original 1.0.0 env. The 1.0.0 runtime had no such switch
# (always local estimate); pkg_v5 defaults to `usage` when the variable is unset, so it is set here.
TERMINUS_GATEWAY_RETRY_ATTEMPTS=6
TERMINUS_MODEL_CONTEXT_LIMIT=262144
TERMINUS_PROACTIVE_SUMMARIZATION_THRESHOLD=65536
TERMINUS_REASONING_EFFORT=max
TERMINUS_SEPARATE_REASONING=true
TERMINUS_STREAM=true
TERMINUS_TEMPERATURE=1.0
TERMINUS_TOKEN_COUNT_MODE=estimate
TERMINUS_TOP_K=50
TERMINUS_TOP_P=0.95
