# cth-terminus-2-stream 1.7.96: 1.6.96 + TERMINUS_TOOL_CALL_MODE=function (forced terminus_action tool).
# Recorded sandbox size 4 cpu / 16Gi / 50Gi; agent deadline 14400 s (TB2.1) or 18000 s (TerminalHorizon).
# Plain KEY=VALUE: usable with `set -a; . file; set +a` and with `docker run --env-file`.
TERMINUS_GATEWAY_RETRY_ATTEMPTS=6
TERMINUS_MAX_TURNS=512
TERMINUS_MODEL_CONTEXT_LIMIT=98304
TERMINUS_PROACTIVE_SUMMARIZATION_THRESHOLD=1024
TERMINUS_REASONING_EFFORT=max
TERMINUS_SANDBOX_ENV_HF_HUB_DISABLE_XET=1
TERMINUS_SANDBOX_ENV_HF_HUB_DOWNLOAD_TIMEOUT=120
TERMINUS_SANDBOX_ENV_HF_HUB_ETAG_TIMEOUT=60
TERMINUS_SANDBOX_ENV_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
TERMINUS_SANDBOX_ENV_PIP_RETRIES=10
TERMINUS_SANDBOX_ENV_PIP_TIMEOUT=60
TERMINUS_SANDBOX_ENV_UV_CONCURRENT_DOWNLOADS=4
TERMINUS_SANDBOX_ENV_UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/
TERMINUS_SANDBOX_ENV_UV_HTTP_RETRIES=6
TERMINUS_SANDBOX_ENV_UV_HTTP_TIMEOUT=600
TERMINUS_SANDBOX_ENV_UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
TERMINUS_SEPARATE_REASONING=true
TERMINUS_STREAM=true
TERMINUS_TEMPERATURE=1.0
TERMINUS_TOKEN_COUNT_MODE=usage
TERMINUS_TOOL_CALL_MODE=function
TERMINUS_TOP_K=50
TERMINUS_TOP_P=0.95
